# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
POSTGRES_DB=call_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# True = process uploads in the web process (no worker needed)
CELERY_TASK_ALWAYS_EAGER=True

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_LLM_MODEL=gpt-4o-mini

# Demo users (created by manage.py seed_demo)
DEMO_USERNAME=admin
DEMO_PASSWORD=admin1234
DEMO_EMAIL=admin@example.com
DEMO_VIEWER_USERNAME=viewer
DEMO_VIEWER_PASSWORD=viewer1234
DEMO_VIEWER_EMAIL=viewer@example.com
