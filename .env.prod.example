# Public hostname for HTTPS (required for Let's Encrypt)
DOMAIN=your.domain.com
CERTBOT_EMAIL=you@example.com

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
# Include DOMAIN + EC2 IP + localhost
DJANGO_ALLOWED_HOSTS=your.domain.com,YOUR_EC2_PUBLIC_IP,localhost,127.0.0.1
# After HTTPS is enabled, use https://your.domain.com
CORS_ALLOWED_ORIGINS=https://your.domain.com

# Database (used by Postgres container + Django)
POSTGRES_DB=call_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery (overridden to redis service in compose; keep for clarity)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_LLM_MODEL=gpt-4o-mini

# Demo users (seeded on first web start when SEED_DEMO=true)
DEMO_USERNAME=admin
DEMO_PASSWORD=change-me-admin-password
DEMO_EMAIL=admin@example.com
DEMO_VIEWER_USERNAME=viewer
DEMO_VIEWER_PASSWORD=change-me-viewer-password
DEMO_VIEWER_EMAIL=viewer@example.com
SEED_DEMO=true
